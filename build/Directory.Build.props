<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      The documentation file is generated so that the compiler resolves every cref in an XML
      comment and a stale reference becomes a build error. 1591 stays suppressed: a comment is
      written where it says something the signature does not, not on every public member.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The build pipeline passes -p:SourceRevisionId=<commit sha>; the .NET SDK appends it to
      InformationalVersion as "<version>+<sha>". RunNow reports that value so the deployed code
      version can be told apart from the Terraform "version" tag on the infrastructure.
    -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
